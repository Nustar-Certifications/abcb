# Copy to .env and set your values (live hosting / production).
# .env is NOT in Git — set passwords once per machine/server.
# Optional: create .env.local with only overrides (e.g. DB_PASSWORD) on your PC; also not in Git.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ab-cb
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# Root site: https://yourdomain.com/  |  Subfolder: https://yourdomain.com/abcb/
APP_URL=https://yourdomain.com/

APP_ENV=production

# Upload .env to the server (same folder as index.html). Set DB_USER / DB_PASSWORD from hosting panel.